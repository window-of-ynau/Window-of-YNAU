# 云农之窗 · 部署环境变量示例
#
# 用法：cp .env.example .env 后把 CHANGE_ME 换掉（本文件是模板，不要直接用于部署）。
#
# 绝对不要提交真实值到 Git、不要贴进 issue/聊天/截图：
#   - POSTGRES_PASSWORD：数据库密码，泄露 = 全部数据可读写
#   - DATABASE_URL：里面含数据库密码，同上
#   - 任何上游模型 Key / 学校 cookie 也不要放这里（BYOK 的 Key 只存在客户端 keystore）
# 也请确认仓库根 .gitignore 忽略 deploy/.env 和 deploy/.env.*（本目录不代改根配置）。

# 数据库密码：只用字母数字或简单符号；若含 @ : / ? # 等字符，DATABASE_URL 里必须做 URL 编码。
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_secret

# 服务端连接串。compose 内部主机名是 db：postgres://<用户>:<密码>@db:5432/<库名>
# 本地直接跑 server（不经 compose）时改成 127.0.0.1:5432。
DATABASE_URL=postgres://yunong:CHANGE_ME_use_a_long_random_secret@db:5432/yunong

RUST_LOG=info

# 同时在途流上限（不做 token 记账，这个才是真正的并发闸门）。
CONCURRENCY_LIMIT=50

# 单轮输入 token 上限，用于"先拒后转"。
MAX_INPUT_TOKENS=32000

# Auto Review 开关。
REVIEW_ENABLED=true

# 可选：宿主机监听地址。默认 127.0.0.1，只给本机反代用；真机局域网联调改成 0.0.0.0。
# SERVER_BIND=127.0.0.1
