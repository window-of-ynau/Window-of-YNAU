# 云农之窗 · 部署环境变量示例
#
# 用法：cp .env.example .env 后把 CHANGE_ME 换掉（本文件是模板，不要直接用于部署）。
#
# 绝对不要提交真实值到 Git、不要贴进 issue/聊天/截图：
#   - POSTGRES_PASSWORD：数据库密码，泄露 = 全部数据可读写
#   - DATABASE_URL：里面含数据库密码，同上
#   - 任何上游模型 Key / 学校 cookie 也不要放这里（BYOK 的 Key 只存在客户端 keystore）
# 也请确认仓库根 .gitignore 忽略 deploy/.env 和 deploy/.env.*（本目录不代改根配置）。

# 数据库密码：只用字母数字或简单符号；若含 @ : / ? # 等字符，DATABASE_URL 里必须做 URL 编码。
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_secret

# 服务端连接串。compose 内部主机名是 db：postgres://<用户>:<密码>@db:5432/<库名>
# 本地直接跑 server（不经 compose）时改成 127.0.0.1:5432。
DATABASE_URL=postgres://yunong:CHANGE_ME_use_a_long_random_secret@db:5432/yunong

RUST_LOG=info

# 同时在途流上限（不做 token 记账，这个才是真正的并发闸门）。
CONCURRENCY_LIMIT=50

# 单轮输入 token 上限，用于"先拒后转"。
MAX_INPUT_TOKENS=32000

# 宿主机侧的端口监听地址（compose 的 ports 映射用）。
# 容器内的 YUNONG_BIND 由 compose 固定为 0.0.0.0:8080，不需要在这里设。
# 默认只绑回环，前面挂 Caddy/Nginx 做 TLS；真机局域网联调才改成 0.0.0.0。
# SERVER_BIND=127.0.0.1

# 注意：Auto Review（ADR-06）尚未实现，服务端没有读取任何 REVIEW_* 变量，
# 所以这里不提供该开关——写了也不会生效。

# ---------- 上游模型（套餐通道用；BYOK 的 Key 只存在客户端 keystore） ----------

# 三家共用同一个上游时只填这两行；要分协议指向不同厂商，再填下面带协议名的。
# ⚠️ 这些是"我们自己的" Key：泄露 = 别人拿我们的钱调模型。绝不提交、不贴截图。
# UPSTREAM_BASE_URL=https://api.deepseek.com
# UPSTREAM_API_KEY=CHANGE_ME_upstream_key

# 按协议分别覆盖（留空则回退到上面的 UPSTREAM_BASE_URL / UPSTREAM_API_KEY）
# UPSTREAM_COMPLETIONS_URL=https://api.deepseek.com
# UPSTREAM_COMPLETIONS_KEY=CHANGE_ME
# UPSTREAM_RESPONSES_URL=https://api.openai.com
# UPSTREAM_RESPONSES_KEY=CHANGE_ME
# UPSTREAM_MESSAGES_URL=https://api.anthropic.com
# UPSTREAM_MESSAGES_KEY=CHANGE_ME

# 上游超时（秒）：建连 / 首字节与空闲。流式回答不设总时长上限。
UPSTREAM_CONNECT_TIMEOUT_SECS=10
# 首事件超时：连上到第一块 SSE 事件。推理模型可能 30~60s 才吐第一个 token，别设太小。
UPSTREAM_FIRST_EVENT_TIMEOUT_SECS=90
# 事件间空闲超时：收到数据就重置。服务端心跳 15s，这里明显大于它。
UPSTREAM_IDLE_TIMEOUT_SECS=30

# 闸门排队（毫秒）：全局 50 并发满时最多排队这么久，超时返回 429 + Retry-After。
CONCURRENCY_QUEUE_MS=5000

# 服务端心跳（秒）：客户端按 30s idle 判死链路，心跳要明显小于它。
SSE_HEARTBEAT_SECS=15

# 1% 抽样记账：只用于成本监控与熔断，不是账单（ADR-03 按时间授权，不按 token 计费）。
USAGE_SAMPLE_PERCENT=1

# 注意：Auto Review 目前尚未接入（ADR-06 留到 W3），所以这里没有 REVIEW_* 开关。